{
  "compilerOptions": {
    "target": "ES2020",                        // Modern JS output
    "module": "commonjs",                      // Node.js compatible modules
    "rootDir": "./src",                        // Your TS source folder
    "outDir": "./dist",                        // Compiled JS output folder
    "esModuleInterop": true,                   // Allow default import interop
    "allowSyntheticDefaultImports": true,      // Allow default imports from CJS modules
    "strict": true,                            // Enable all strict type-checking options
    "forceConsistentCasingInFileNames": true, // File name casing check
    "skipLibCheck": true,                      // Skip type checking of all declaration files
    "resolveJsonModule": true,                 // Allow importing JSON modules
    "noImplicitAny": true,                     // Disallow implicit `any` types
    "noUnusedLocals": true,                    // Report unused locals
    "noUnusedParameters": true,                // Report unused function parameters
    "sourceMap": true                          // Generate source maps for debugging
  },
  "include": ["src/**/*.ts"],                  // Include all TS files in src
  "exclude": ["node_modules", "dist"]          // Exclude node_modules and dist
}
